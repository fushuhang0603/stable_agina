# =====================================================================
# 环境变量模板：复制为 deploy/.env 后修改（deploy/.env 已被 .gitignore 忽略）
#   cp .env.example .env        （Linux/macOS）
#   copy .env.example .env      （Windows）
# 密码请使用强口令，切勿提交真实值到仓库
# =====================================================================

# ---------- Spring ----------
SPRING_PROFILES_ACTIVE=prod
# 后端 JVM 参数
JAVA_OPTS=-XX:MaxRAMPercentage=75.0

# ---------- MySQL ----------
MYSQL_ROOT_PASSWORD=StableAngina@123
MYSQL_DATABASE=stable_angina
MYSQL_PORT=3306

# ---------- Redis ----------
REDIS_PASSWORD=StableAngina@123
REDIS_PORT=6379

# ---------- MinIO ----------
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_BUCKET=stable-angina
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# ---------- 应用端口 ----------
API_PORT=8080
NGINX_PORT=80

# ---------- JWT ----------
# 至少 32 字节随机串（HS256），生产务必更换
JWT_SECRET=stable-angina-dev-only-secret-key-please-change-in-prod

# ---------- 大模型（DeepSeek） ----------
# 未拿到 Key 时保持 AI_MOCK=true，返回固定六段样例
AI_MOCK=true
DEEPSEEK_API_KEY=sk-mock-placeholder
